rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // User profiles: readable by everyone for student discovery, writable by authenticated users
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Friends and Connections between students
    match /connections/{connectionId} {
      allow read, write: if isAuthenticated();
    }

    // Direct conversations and real-time chat messages
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Hackathons, Competitions & Campus Events
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Collaborative Projects
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Hackathon Teams & Teammate Builder
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
